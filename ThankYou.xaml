<Window x:Name="window" x:Class="rans0m.ThankYou"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:rans0m"
        mc:Ignorable="d"
        Title="RANS0M" Height="350" Width="560" ResizeMode="NoResize" Topmost="True" Loaded="Window_Loaded" Closing="OnClosing" ShowInTaskbar="False" Background="Black">
    <Viewbox Stretch="UniformToFill">
        <Grid x:Name="grid" Width="560" Height="350">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF81DE00"/>
                    <GradientStop Color="#FF117F00"/>
                    <GradientStop Color="#FE7DDC00"/>
                    <GradientStop Color="#FE4AB100"/>
                    <GradientStop Color="#FE309900"/>
                    <GradientStop Color="#FE80DD00"/>
                    <GradientStop Color="#FE5ABE00"/>
                    <GradientStop Color="#FE49B000"/>
                    <GradientStop Color="#FE2E9800"/>
                    <GradientStop Color="#FE48AF00"/>
                    <GradientStop Color="#FE1A8600"/>
                    <GradientStop Color="#FE7DDC00"/>
                    <GradientStop Color="#FE7DDC00" Offset="0.25"/>
                    <GradientStop Color="#FE5BBF00" Offset="0.255"/>
                    <GradientStop Color="#FE5BBF00" Offset="0.458"/>
                    <GradientStop Color="#FE4AB100" Offset="0.458"/>
                    <GradientStop Color="#FE4AB100" Offset="0.632"/>
                    <GradientStop Color="#FE309900" Offset="0.64"/>
                    <GradientStop Color="#FE309900" Offset="0.876"/>
                    <GradientStop Color="#FE117F00" Offset="0.884"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image x:Name="img_oksign" HorizontalAlignment="Center" Height="194" VerticalAlignment="Top" Width="194" Source="/Assets/ok_sign.png" Margin="0,97,0,0" RenderTransformOrigin="0.5,0.3">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="scaleOkSign" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>
            <Image x:Name="img_thx" HorizontalAlignment="Center" Height="87" VerticalAlignment="Top" Width="488" Source="/Assets/thx_txt.png" Margin="0,14,0,0" RenderTransformOrigin="0.5,1">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="scaleTxtThx" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>
            <Image x:Name="img_ransom" HorizontalAlignment="Left" Height="188" Margin="28,12,0,0" VerticalAlignment="Top" Width="188" Source="/Assets/ransom_idle.png"/>
        </Grid>
    </Viewbox>
</Window>