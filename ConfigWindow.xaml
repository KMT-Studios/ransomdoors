<Window x:Class="rans0m.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:rans0m"
        mc:Ignorable="d"
        Title="Configuration" Height="926" Width="302" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFB5A87B" Offset="1"/>
                <GradientStop Color="#FF230063" Offset="0"/>
                <GradientStop Color="#FF230062"/>
                <GradientStop Color="#FF30005B" Offset="0.283"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Image HorizontalAlignment="Left" Height="110" Margin="10,10,0,0" VerticalAlignment="Top" Width="107" Source="/Assets/Starlight.png" RenderTransformOrigin="0.525,0.537">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="7.721"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <TextBlock HorizontalAlignment="Left" Margin="118,34,0,0" TextWrapping="Wrap" Text="Ransom's Configuration" VerticalAlignment="Top" Height="68" Width="164" FontWeight="Bold" FontFamily="Nyala" FontSize="30">
            <TextBlock.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFEDF77"/>
                    <GradientStop Color="White" Offset="1"/>
                    <GradientStop Color="#FFFFF2C6" Offset="0.5"/>
                    <GradientStop Color="#FEFEE17F" Offset="0.398"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>
        <GroupBox HorizontalAlignment="Left" Height="136" Header="Behavior" Margin="13,118,0,0" VerticalAlignment="Top" Width="259" Foreground="White" RenderTransformOrigin="0.5,0.5"/>
        <TextBlock HorizontalAlignment="Left" Height="18" Margin="23,158,0,0" TextWrapping="Wrap" Text="Minimum Delay" VerticalAlignment="Top" Width="115" Foreground="White"/>
        <TextBox x:Name="tb_minSpawnDelay" HorizontalAlignment="Left" Height="22" Margin="23,176,0,0" TextWrapping="Wrap" Text="5" VerticalAlignment="Top" Width="115" MaxLines="1" MaxLength="6" local:NumericBehavior.NumericOnly="True"/>
        <TextBlock HorizontalAlignment="Left" Height="18" Margin="147,158,0,0" TextWrapping="Wrap" Text="Maximum Delay" VerticalAlignment="Top" Width="115" Foreground="White"/>
        <TextBox local:NumericBehavior.NumericOnly="True" x:Name="tb_maxSpawnDelay" HorizontalAlignment="Left" Height="22" Margin="147,176,0,0" TextWrapping="Wrap" Text="600" VerticalAlignment="Top" Width="115" MaxLines="1" MaxLength="6"/>
        <TextBlock HorizontalAlignment="Left" Margin="103,453,0,0" TextWrapping="Wrap" Text="Made by Ixar" VerticalAlignment="Top" Height="18" Width="79" FontSize="16" FontWeight="Bold" FontFamily="Nyala">
            <TextBlock.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF4200FF"/>
                    <GradientStop Color="Black" Offset="1"/>
                    <GradientStop Color="#FF611BFF" Offset="0.5"/>
                    <GradientStop Color="#FE942EFF" Offset="0.398"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>
        <GroupBox HorizontalAlignment="Left" Height="89" Header="Death Consequences" Margin="13,255,0,0" VerticalAlignment="Top" Width="259" Foreground="White" RenderTransformOrigin="0.5,0.5"/>
        <TextBox x:Name="tb_cmd" HorizontalAlignment="Left" Height="20" Margin="23,314,0,0" TextWrapping="Wrap" Text="shutdown /s /t 0" VerticalAlignment="Top" Width="242" MaxLines="1" MaxLength="500" IsEnabled="False"/>
        <CheckBox x:Name="cb_cmdOnDeath" Content="Custom command on death" HorizontalAlignment="Left" Margin="23,296,0,0" VerticalAlignment="Top" Foreground="White" Click="cb_cmdOnDeath_Click"/>
        <CheckBox x:Name="cb_crashOnDeath" Content="Crash on death" HorizontalAlignment="Left" Margin="23,275,0,0" VerticalAlignment="Top" Foreground="White"/>
        <GroupBox HorizontalAlignment="Left" Height="100" Header="Coins" Margin="13,344,0,0" VerticalAlignment="Top" Width="259" Foreground="White" RenderTransformOrigin="0.5,0.5"/>
        <RadioButton x:Name="rb_userFolderMode" Content="Spawns in your own folders" HorizontalAlignment="Left" Margin="23,361,0,0" VerticalAlignment="Top" GroupName="CoinsMode" Foreground="White"/>
        <RadioButton x:Name="rb_drawerMode" Content="Spawns in &quot;drawers&quot;" HorizontalAlignment="Left" Margin="23,381,0,0" VerticalAlignment="Top" GroupName="CoinsMode" Foreground="White"/>
        <TextBlock HorizontalAlignment="Left" Height="19" Margin="23,397,0,0" TextWrapping="Wrap" Text="Ransom Amount" VerticalAlignment="Top" Width="122" Foreground="White"/>
        <TextBox x:Name="tb_ransomAmount" HorizontalAlignment="Left" Height="21" Margin="23,416,0,0" TextWrapping="Wrap" Text="500" VerticalAlignment="Top" Width="242" MaxLines="1" MaxLength="7" local:NumericBehavior.NumericOnly="True"/>
        <TextBlock HorizontalAlignment="Left" Height="19" Margin="23,204,0,0" TextWrapping="Wrap" Text="Ransom Duration" VerticalAlignment="Top" Width="122" Foreground="White"/>
        <TextBox x:Name="tb_duration" HorizontalAlignment="Left" Height="21" Margin="23,223,0,0" TextWrapping="Wrap" Text="90" VerticalAlignment="Top" Width="115" MaxLines="1" MaxLength="5" local:NumericBehavior.NumericOnly="True"/>
        <CheckBox x:Name="cb_spawnAutomatically" Content="Spawn Automatically" HorizontalAlignment="Left" Margin="23,140,0,0" VerticalAlignment="Top" Foreground="White" Click="cb_spawnAutomatically_Click"/>
        <Button x:Name="btn_spawn" Content="Spawn" HorizontalAlignment="Left" Height="21" Margin="147,223,0,0" VerticalAlignment="Top" Width="115" Background="White" Click="btn_spawn_Click"/>

        <GroupBox x:Name="gb_twitch" HorizontalAlignment="Left" Height="420" Header="Twitch Redemption" Margin="13,470,0,0" VerticalAlignment="Top" Width="259" Foreground="White"/>
        <CheckBox x:Name="cb_twitchEnabled" Content="Trigger from chat points" HorizontalAlignment="Left" Margin="23,488,0,0" VerticalAlignment="Top" Foreground="White" Click="cb_twitchEnabled_Click"/>
        <TextBlock x:Name="txt_twitchAutoSpawnNote" HorizontalAlignment="Left" Height="26" Margin="23,526,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="242" Foreground="#d8b0ff" FontSize="9" Text="Enabling this turns off Spawn Automatically, so the entity only appears when someone redeems."/>
        <TextBlock HorizontalAlignment="Left" Height="18" Margin="23,556,0,0" TextWrapping="Wrap" Text="Channel" VerticalAlignment="Top" Width="122" Foreground="White"/>
        <TextBox x:Name="tb_twitchChannel" HorizontalAlignment="Left" Height="22" Margin="23,574,0,0" VerticalAlignment="Top" Width="242" MaxLines="1" MaxLength="50"/>
        <TextBlock HorizontalAlignment="Left" Height="18" Margin="23,600,0,0" TextWrapping="Wrap" Text="Client ID" VerticalAlignment="Top" Width="122" Foreground="White"/>
        <TextBox x:Name="tb_clientId" HorizontalAlignment="Left" Height="22" Margin="23,618,0,0" VerticalAlignment="Top" Width="242" MaxLines="1" MaxLength="100"/>
        <TextBlock HorizontalAlignment="Left" Height="18" Margin="23,644,0,0" TextWrapping="Wrap" Text="Client secret" VerticalAlignment="Top" Width="122" Foreground="White"/>
        <TextBox x:Name="tb_clientSecret" HorizontalAlignment="Left" Height="22" Margin="23,662,0,0" VerticalAlignment="Top" Width="242" MaxLines="1" MaxLength="200"/>
        <TextBlock HorizontalAlignment="Left" Height="18" Margin="23,688,0,0" TextWrapping="Wrap" Text="Redirect URI" VerticalAlignment="Top" Width="122" Foreground="White"/>
        <TextBox x:Name="tb_redirectUri" HorizontalAlignment="Left" Height="22" Margin="23,706,0,0" VerticalAlignment="Top" Width="242" MaxLines="1" MaxLength="200"/>
        <TextBlock x:Name="txt_redirectUriNote" HorizontalAlignment="Left" Height="26" Margin="23,730,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="242" Foreground="#d8b0ff" FontSize="9" Text="Must match an OAuth Redirect URL in your Twitch app exactly."/>
        <Button x:Name="btn_twitchConnect" Content="Connect" HorizontalAlignment="Left" Height="22" Margin="23,764,0,0" VerticalAlignment="Top" Width="115" Background="White" Click="btn_twitchConnect_Click"/>
        <TextBlock x:Name="txt_twitchStatus" HorizontalAlignment="Left" Height="34" Margin="147,764,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="118" Foreground="White" FontSize="10" Text="Not connected"/>
        <TextBlock HorizontalAlignment="Left" Height="18" Margin="23,792,0,0" TextWrapping="Wrap" Text="Reward that infects you" VerticalAlignment="Top" Width="242" Foreground="White" FontSize="10"/>
        <ComboBox x:Name="cb_triggerReward" HorizontalAlignment="Left" Height="22" Margin="23,810,0,0" VerticalAlignment="Top" Width="242" DisplayMemberPath="Label" SelectedValuePath="Id"/>
        <TextBlock HorizontalAlignment="Left" Height="18" Margin="23,834,0,0" TextWrapping="Wrap" Text="Reward that forces the attack" VerticalAlignment="Top" Width="242" Foreground="White" FontSize="10"/>
        <ComboBox x:Name="cb_forceReward" HorizontalAlignment="Left" Height="22" Margin="23,852,0,0" VerticalAlignment="Top" Width="242" DisplayMemberPath="Label" SelectedValuePath="Id"/>
        <TextBlock HorizontalAlignment="Left" Height="18" Margin="23,876,0,0" TextWrapping="Wrap" Text="Reward that dismisses it" VerticalAlignment="Top" Width="242" Foreground="White" FontSize="10"/>
        <ComboBox x:Name="cb_dismissReward" HorizontalAlignment="Left" Height="22" Margin="23,894,0,0" VerticalAlignment="Top" Width="242" DisplayMemberPath="Label" SelectedValuePath="Id"/>
    </Grid>
</Window>
